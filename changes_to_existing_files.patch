+_VOICED_CONS = ("g", "j", "ḍ", "d", "b", "ṅ", "ñ", "ṇ", "n", "m", "y", "r", "l", "v", "h")
+_JUNCTION_PARTICLES_A = {"ca", "na", "iva", "eva", "ha", "sma", "atha", "tathā", "yathā",
+                         "hā", "vā", "mā", "sadā", "tadā", "yadā", "kadā", "sarvadā"}
+_TRUE_R_FINALS = {"punar", "antar", "prātar", "svar", "ahar", "dvār", "gir", "pur"}
